 // Runs the game's timer and hardware interrupts. Translated code checks in here
 // regularly, and the game's own handlers do the rest.
+#include <stdatomic.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <time.h>
@@ -41,6 +42,13 @@
 static uint64_t time_base_offset;
 static uint64_t guest_time_offset;
 
+extern unsigned jd_couch_boot_rate(void) __attribute__((weak));
+enum { CONTROLLER_MENU_RATE = 3 };
+static unsigned boot_rate;
+static uint64_t boot_started;
+static _Atomic uint64_t boot_menu_started;
+static _Atomic uint64_t boot_finished;
+
 #ifdef __APPLE__
 // The game reads the clock constantly, and clock_gettime goes the long way round here.
 static uint64_t monotonic_nanoseconds(void) {
@@ -68,6 +76,8 @@
 // The game reads the time base as ticks since 2000 in local time.
 // A fixed offset, set once, keeps every interval and deadline exactly as it was.
 void time_start(void) {
+  if (jd_couch_boot_rate) boot_rate = jd_couch_boot_rate();
+  if (boot_rate > 1) boot_started = monotonic_ticks();
   time_t now = time(0);
 #ifdef _WIN32
   struct tm local;
@@ -81,7 +91,29 @@
 #endif
 }
 
-uint64_t time_base(void) { return monotonic_ticks() + time_base_offset; }
+int time_boot_fast(void) {
+  return boot_started && !atomic_load_explicit(&boot_finished, memory_order_relaxed);
+}
+
+void time_boot_controller_menu(void) {
+  if (boot_rate > CONTROLLER_MENU_RATE && time_boot_fast())
+    atomic_store_explicit(&boot_menu_started, monotonic_ticks(), memory_order_relaxed);
+}
+
+void time_boot_finish(void) {
+  if (time_boot_fast()) atomic_store_explicit(&boot_finished, monotonic_ticks(), memory_order_relaxed);
+}
+
+uint64_t time_base(void) {
+  uint64_t now = monotonic_ticks();
+  if (!boot_started) return now + time_base_offset;
+  uint64_t end = atomic_load_explicit(&boot_finished, memory_order_relaxed);
+  uint64_t scaled_until = end && end < now ? end : now;
+  uint64_t menu = atomic_load_explicit(&boot_menu_started, memory_order_relaxed);
+  uint64_t early_until = menu && menu < scaled_until ? menu : scaled_until;
+  return now + time_base_offset + (early_until - boot_started) * (boot_rate - 1)
+       + (scaled_until - early_until) * (CONTROLLER_MENU_RATE - 1);
+}
 
 uint64_t guest_time_base(void) { return time_base() + guest_time_offset; }
 
