+// The vendor-device manager in IOS 57–59. Empty USB ports report zero devices.
+enum {
+  VEN_GET_VERSION = 0, VEN_GET_DEVICE_CHANGE = 1, VEN_SHUTDOWN = 2, VEN_ATTACH_FINISH = 6,
+  VEN_VERSION = 0x50001, VEN_VERSION_BYTES = 0x20, VEN_DEVICE_LIST_BYTES = 0x180,
+};
+static int ven_list_due = 1;
+static uint32_t ven_waiting_change;
+
+void usb_ven_closed(void) {
+  if (ven_waiting_change) ios_complete(ven_waiting_change, 0);
+  ven_waiting_change = 0;
+  ven_list_due = 1;
+}
+
+int usb_ven_request(uint32_t command, uint32_t request) {
+  if (command != IOS_IOCTL) return IOS_UNHANDLED;
+  uint32_t code = rd32(request + 12), in = rd32(request + 16), in_bytes = rd32(request + 20);
+  uint32_t out = rd32(request + 24), out_bytes = rd32(request + 28);
+  if (in || in_bytes) return IOS_UNHANDLED;
+  switch (code) {
+    case VEN_GET_VERSION:
+      if (!out || out_bytes != VEN_VERSION_BYTES) return IOS_EINVAL;
+      wr32(guest(out), VEN_VERSION);
+      return 0;
+    case VEN_GET_DEVICE_CHANGE:
+      if (!out || out_bytes != VEN_DEVICE_LIST_BYTES || ven_waiting_change) return IOS_EINVAL;
+      if (ven_list_due) {
+        ven_list_due = 0;
+        return 0;
+      }
+      ven_waiting_change = request;
+      return IOS_NO_REPLY;
+    case VEN_SHUTDOWN:
+      if (out || out_bytes) return IOS_EINVAL;
+      usb_ven_closed();
+      return 0;
+    case VEN_ATTACH_FINISH:
+      return 0;
+    default:
+      return IOS_UNHANDLED;
+  }
+}
