+  return 1;
+}
+
+static void *output_thread(void *unused) {
+  (void)unused;
+  static int16_t period[PERIOD_SAMPLES * AUDIO_CHANNELS];
+  // The grid owns the host audio device for previews until a song is chosen.
+  const struct timespec period_time = {0, 1000000000L * PERIOD_SAMPLES / AUDIO_SAMPLE_RATE};
+  while (jd_couch_waiting_for_song && jd_couch_waiting_for_song()) {
+    audio_pull(period, PERIOD_SAMPLES);
+    nanosleep(&period_time, NULL);
+  }
+  if (!open_device()) return NULL;
+  while (1) {
+    audio_pull(period, PERIOD_SAMPLES);
+    if (jd_couch_loading && jd_couch_loading()) memset(period, 0, sizeof period);
+    snd_pcm_uframes_t position = 0;
+    while (position < PERIOD_SAMPLES) {
+      snd_pcm_sframes_t wrote = snd_pcm_writei(device, period + position * AUDIO_CHANNELS,
+                                              PERIOD_SAMPLES - position);
+      if (wrote > 0) position += wrote;
+      else if (wrote < 0 && snd_pcm_recover(device, (int)wrote, 1) < 0) return NULL;
+    }
+  }
+}
+
+int audio_output_open(void) {
   pthread_t thread;
   return pthread_create(&thread, 0, output_thread, 0) == 0;
 }
