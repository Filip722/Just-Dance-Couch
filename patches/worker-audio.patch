--- a/recomp/runtime/audio_output_linux.c
+++ b/recomp/runtime/audio_output_linux.c
@@ -2,34 +2,67 @@
 // PipeWire. ALSA has no callback here, so a thread of our own writes each period.
 #include <alsa/asoundlib.h>
 #include <pthread.h>
+#include <string.h>
+#include <time.h>
 
 #include "audio.h"
 
 #define PERIOD_SAMPLES (AUDIO_FRAME_SAMPLES * 4)
 #define LATENCY_MICROSECONDS 40000
+// Two device periods at 2048 frames and 48 kHz fit in this buffer.
+#define RECOVERY_LATENCY_MICROSECONDS 100000
 
 static snd_pcm_t *device;
+extern int jd_couch_loading(void) __attribute__((weak));
+extern int jd_couch_waiting_for_song(void) __attribute__((weak));
 
-static void *output_thread(void *unused) {
-  (void)unused;
-  static int16_t period[PERIOD_SAMPLES * AUDIO_CHANNELS];
-  while (1) {
-    audio_pull(period, PERIOD_SAMPLES);
-    snd_pcm_sframes_t wrote = snd_pcm_writei(device, period, PERIOD_SAMPLES);
-    if (wrote < 0 && snd_pcm_recover(device, (int)wrote, 1) < 0) return 0;
-  }
-}
-
-int audio_output_open(void) {
+static int open_device(unsigned latency) {
   int error = snd_pcm_open(&device, "default", SND_PCM_STREAM_PLAYBACK, 0);
   if (error >= 0) {
     error = snd_pcm_set_params(device, SND_PCM_FORMAT_S16_LE, SND_PCM_ACCESS_RW_INTERLEAVED, AUDIO_CHANNELS,
-                               AUDIO_SAMPLE_RATE, 1, LATENCY_MICROSECONDS);
+                               AUDIO_SAMPLE_RATE, 1, latency);
   }
   if (error < 0) {
     fprintf(stderr, "sound device: %s\n", snd_strerror(error));
     return 0;
   }
+  return 1;
+}
+
+static void *output_thread(void *unused) {
+  (void)unused;
+  static int16_t period[PERIOD_SAMPLES * AUDIO_CHANNELS];
+  // The grid owns the host audio device for previews until a song is chosen.
+  const struct timespec period_time = {0, 1000000000L * PERIOD_SAMPLES / AUDIO_SAMPLE_RATE};
+  while (jd_couch_waiting_for_song && jd_couch_waiting_for_song()) {
+    audio_pull(period, PERIOD_SAMPLES);
+    nanosleep(&period_time, NULL);
+  }
+  unsigned latency = LATENCY_MICROSECONDS;
+  if (!open_device(latency)) return NULL;
+  while (1) {
+    audio_pull(period, PERIOD_SAMPLES);
+    if (jd_couch_loading && jd_couch_loading()) memset(period, 0, sizeof period);
+    snd_pcm_uframes_t position = 0;
+    while (position < PERIOD_SAMPLES) {
+      snd_pcm_sframes_t wrote = snd_pcm_writei(device, period + position * AUDIO_CHANNELS,
+                                              PERIOD_SAMPLES - position);
+      if (wrote > 0) {
+        position += wrote;
+      } else if (wrote == -EPIPE && latency == LATENCY_MICROSECONDS) {
+        // Some PipeWire graphs consume an entire small ALSA buffer in a single cycle.
+        snd_pcm_close(device);
+        latency = RECOVERY_LATENCY_MICROSECONDS;
+        fprintf(stderr, "sound device: underrun, retrying with a %u ms buffer\n", latency / 1000);
+        if (!open_device(latency)) return NULL;
+      } else if (wrote < 0 && snd_pcm_recover(device, (int)wrote, 1) < 0) {
+        return NULL;
+      }
+    }
+  }
+}
+
+int audio_output_open(void) {
   pthread_t thread;
   return pthread_create(&thread, 0, output_thread, 0) == 0;
 }
